declare class PromptInjectionScanner implements Scanner {
    /** @inheritdoc */
    readonly name = "prompt-injection";
    private readonly compiledPatterns;
    private readonly strictness;
    private readonly blockAt;
    private readonly hitlAt;
    constructor(options?: PromptInjectionOptions);
    /** @inheritdoc */
    scan(input: string, ctx?: ScanContext): ScanResult;
}
/** Convenience singleton using default (moderate) settings. */
declare const defaultPromptInjectionScanner: PromptInjectionScanner;
/**
 * Scan a single string for prompt injection signals using configurable options.
